<Window x:Class="QuietCapture.ScreenRecorderLibSpike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuietCapture G0-1 Area Capture"
        Width="780"
        Height="640"
        MinWidth="720"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="G0-1 — Area Capture" />
      <TextBlock Margin="0,6,0,0"
                 TextWrapping="Wrap"
                 Text="This harness passes a selected display and ScreenRect directly to ScreenRecorderLib. X/Y are experimental source coordinates; Width/Height must be positive even values for the initial H.264 tests." />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="Display" />
      <ComboBox x:Name="DisplayComboBox" Grid.Column="1" MinWidth="420" DisplayMemberPath="Label" />
      <Button Grid.Column="2" Margin="10,0,0,0" Padding="14,6" Content="Refresh" Click="RefreshDisplaysButton_Click" />
    </Grid>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="90" />
        <ColumnDefinition Width="40" />
        <ColumnDefinition Width="90" />
        <ColumnDefinition Width="60" />
        <ColumnDefinition Width="100" />
        <ColumnDefinition Width="70" />
        <ColumnDefinition Width="100" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="SourceRect" />
      <TextBox x:Name="XTextBox" Grid.Column="1" Text="0" />
      <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Y" />
      <TextBox x:Name="YTextBox" Grid.Column="3" Text="0" />
      <TextBlock Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Width" />
      <TextBox x:Name="WidthTextBox" Grid.Column="5" Text="1280" />
      <TextBlock Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Height" />
      <TextBox x:Name="HeightTextBox" Grid.Column="7" Text="720" />
    </Grid>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="Output MP4" />
      <TextBox x:Name="OutputPathTextBox" Grid.Column="1" />
      <Button Grid.Column="2" Margin="10,0,0,0" Padding="14,6" Content="Browse..." Click="BrowseButton_Click" />
    </Grid>

    <StackPanel Grid.Row="4" Margin="0,16,0,16" Orientation="Horizontal">
      <CheckBox x:Name="IncludeCursorCheckBox" VerticalAlignment="Center" IsChecked="True" Content="Include cursor" />
      <Button x:Name="StartButton" Margin="24,0,0,0" Padding="20,8" Content="Start" Click="StartButton_Click" />
      <Button x:Name="StopButton" Margin="10,0,0,0" Padding="20,8" Content="Stop" IsEnabled="False" Click="StopButton_Click" />
      <TextBlock x:Name="StateTextBlock" Margin="20,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Idle" />
    </StackPanel>

    <TextBox x:Name="LogTextBox"
             Grid.Row="5"
             IsReadOnly="True"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"
             TextWrapping="NoWrap" />
  </Grid>
</Window>
