<Window x:Class="QuietCapture.ScreenRecorderLibSpike.Gates.G05CaptureExclusion.G05StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320"
        Height="86"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Focusable="False">
  <Border CornerRadius="12"
          Padding="16,10"
          Background="#E61B1B1F"
          BorderBrush="#FFFF3BC8"
          BorderThickness="3">
    <StackPanel>
      <TextBlock Foreground="White"
                 FontSize="18"
                 FontWeight="Bold"
                 Text="QUIETCAPTURE G0-5 STATUS" />
      <TextBlock x:Name="TimerTextBlock"
                 Margin="0,4,0,0"
                 Foreground="#FFFF7ED8"
                 FontSize="15"
                 Text="REC 00:00.0" />
    </StackPanel>
  </Border>
</Window>
