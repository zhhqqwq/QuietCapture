<Window x:Class="QuietCapture.ScreenRecorderLibSpike.Gates.G02SystemAudio.G02SystemAudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuietCapture G0-2 System Audio"
        Width="840"
        Height="650"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="G0-2 — System Audio" />
      <TextBlock Margin="0,6,0,0"
                 TextWrapping="Wrap"
                 Text="Records one full display plus one explicitly selected loopback output device. The selected device ID is bound before recording starts and is written to the run report." />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="Video display" />
      <ComboBox x:Name="DisplayComboBox" Grid.Column="1" MinWidth="460" DisplayMemberPath="Label" />
      <Button Grid.Column="2" Margin="10,0,0,0" Padding="14,6" Content="Refresh" Click="RefreshButton_Click" />
    </Grid>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="System audio device" />
      <ComboBox x:Name="AudioDeviceComboBox" Grid.Column="1" MinWidth="520" DisplayMemberPath="Label" />
    </Grid>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="Output MP4" />
      <TextBox x:Name="OutputPathTextBox" Grid.Column="1" />
      <Button Grid.Column="2" Margin="10,0,0,0" Padding="14,6" Content="Browse..." Click="BrowseButton_Click" />
    </Grid>

    <StackPanel Grid.Row="4" Margin="0,16,0,16" Orientation="Horizontal">
      <Button x:Name="StartButton" Padding="20,8" Content="Start" Click="StartButton_Click" />
      <Button x:Name="StopButton" Margin="10,0,0,0" Padding="20,8" Content="Stop" IsEnabled="False" Click="StopButton_Click" />
      <TextBlock x:Name="StateTextBlock" Margin="20,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Idle" />
      <TextBlock x:Name="AudioPacketTextBlock" Margin="20,0,0,0" VerticalAlignment="Center" Text="Audio packets: 0" />
    </StackPanel>

    <TextBox x:Name="LogTextBox"
             Grid.Row="5"
             IsReadOnly="True"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"
             TextWrapping="NoWrap" />
  </Grid>
</Window>
