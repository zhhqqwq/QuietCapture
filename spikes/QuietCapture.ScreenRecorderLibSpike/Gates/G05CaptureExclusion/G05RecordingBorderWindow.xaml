<Window x:Class="QuietCapture.ScreenRecorderLibSpike.Gates.G05CaptureExclusion.G05RecordingBorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720"
        Height="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Focusable="False">
  <Border BorderBrush="#FF72FF57"
          BorderThickness="6"
          Background="#01000000">
    <Grid>
      <Border HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="12"
              Padding="8,4"
              Background="#E6000000"
              BorderBrush="#FF72FF57"
              BorderThickness="2">
        <TextBlock Foreground="White"
                   FontWeight="Bold"
                   Text="G0-5 RECORDING BORDER" />
      </Border>
    </Grid>
  </Border>
</Window>
