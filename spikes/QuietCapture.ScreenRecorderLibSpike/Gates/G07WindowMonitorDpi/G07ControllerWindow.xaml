<Window x:Class="QuietCapture.ScreenRecorderLibSpike.Gates.G07WindowMonitorDpi.G07ControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuietCapture G0-7 Window + Monitor + DPI"
        Width="940"
        Height="780"
        MinWidth="860"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock FontSize="22"
                 FontWeight="SemiBold"
                 Text="G0-7 — Window + Monitor + DPI" />
      <TextBlock Margin="0,6,0,0"
                 TextWrapping="Wrap"
                 Text="Captures Window, Monitor, or Area while recording display topology, physical-pixel bounds, work areas, DPI/scaling, negative coordinates, and a timed Window action timeline." />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="170" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TextBlock VerticalAlignment="Center" Text="Capture mode" />
      <ComboBox x:Name="CaptureModeComboBox"
                Grid.Column="1"
                SelectedIndex="0">
        <ComboBoxItem Content="Window" />
        <ComboBoxItem Content="Monitor" />
        <ComboBoxItem Content="Area" />
      </ComboBox>

      <TextBlock Grid.Column="2"
                 Margin="24,0,0,0"
                 VerticalAlignment="Center"
                 Text="Display capture API" />
      <ComboBox x:Name="DisplayApiComboBox"
                Grid.Column="3"
                SelectedIndex="0">
        <ComboBoxItem Content="DesktopDuplication" />
        <ComboBoxItem Content="WindowsGraphicsCapture" />
      </ComboBox>
    </Grid>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="Selected display" />
      <ComboBox x:Name="DisplayComboBox"
                Grid.Column="1"
                MinWidth="520"
                DisplayMemberPath="Label" />
      <Button Grid.Column="2"
              Margin="10,0,0,0"
              Padding="14,6"
              Content="Refresh displays"
              Click="RefreshDisplaysButton_Click" />
    </Grid>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="170" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TextBlock VerticalAlignment="Center" Text="Window script" />
      <ComboBox x:Name="WindowScriptComboBox"
                Grid.Column="1"
                SelectedIndex="1">
        <ComboBoxItem Content="NoActions" />
        <ComboBoxItem Content="Lifecycle" />
        <ComboBoxItem Content="CrossMonitor" />
      </ComboBox>

      <TextBlock Grid.Column="2"
                 Margin="24,0,0,0"
                 VerticalAlignment="Center"
                 Text="Step seconds" />
      <TextBox x:Name="StepSecondsTextBox"
               Grid.Column="3"
               Text="2" />
    </Grid>

    <Grid Grid.Row="4" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="80" />
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="80" />
        <ColumnDefinition Width="64" />
        <ColumnDefinition Width="100" />
        <ColumnDefinition Width="64" />
        <ColumnDefinition Width="100" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TextBlock VerticalAlignment="Center" Text="Area SourceRect" />
      <TextBox x:Name="AreaXTextBox"
               Grid.Column="1"
               Text="0" />
      <TextBlock Grid.Column="2"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Text="Y" />
      <TextBox x:Name="AreaYTextBox"
               Grid.Column="3"
               Text="0" />
      <TextBlock Grid.Column="4"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Text="Width" />
      <TextBox x:Name="AreaWidthTextBox"
               Grid.Column="5"
               Text="1280" />
      <TextBlock Grid.Column="6"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Text="Height" />
      <TextBox x:Name="AreaHeightTextBox"
               Grid.Column="7"
               Text="720" />
    </Grid>

    <Grid Grid.Row="5" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="170" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TextBlock VerticalAlignment="Center" Text="No-action seconds" />
      <TextBox x:Name="NoActionSecondsTextBox"
               Grid.Column="1"
               Text="8" />

      <TextBlock Grid.Column="2"
                 Margin="24,0,0,0"
                 VerticalAlignment="Center"
                 Text="Coordinates" />
      <TextBlock Grid.Column="3"
                 VerticalAlignment="Center"
                 Text="monitor snapshot = virtual pixels; Area SourceRect = selected-source local pixels" />
    </Grid>

    <Grid Grid.Row="6" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="Evidence root" />
      <TextBox x:Name="EvidenceRootTextBox"
               Grid.Column="1"
               IsReadOnly="True" />
    </Grid>

    <StackPanel Grid.Row="7"
                Margin="0,18,0,16"
                Orientation="Horizontal">
      <Button x:Name="RunButton"
              Padding="20,8"
              Content="Run G0-7"
              Click="RunButton_Click" />
      <TextBlock x:Name="StateTextBlock"
                 Margin="20,0,0,0"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Text="Idle" />
      <TextBlock x:Name="DisplaySummaryTextBlock"
                 Margin="20,0,0,0"
                 VerticalAlignment="Center"
                 Text="Displays: 0" />
    </StackPanel>

    <TextBox x:Name="LogTextBox"
             Grid.Row="8"
             IsReadOnly="True"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"
             TextWrapping="NoWrap" />
  </Grid>
</Window>
